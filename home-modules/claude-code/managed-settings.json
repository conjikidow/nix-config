      "Read(~/.local/share/keyrings/**)",
      "Read(~/.local/state/python/python_history)",
      "Read(~/.local/state/zsh/history)",
      "Read(~/.netrc)",
      "Read(~/.node_repl_history)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.python_history)",
      "Read(~/.ssh/**)",
      "Read(~/.viminfo)",
      "Read(~/.zsh_history)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command // empty' | tr '\\n' ';' | grep -qE '(^|[&;|])[[:space:]]*cd[[:space:]].*[&;|][[:space:]]*git([[:space:]]|$)' && printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Use `git -C <path> <subcmd>` instead of `cd <path> && git ...` (rules/git-commands.md). Repeat git -C for each git when chaining.\"}}' || true"
          }
        ]
      }
    ]
  }
}
