            "command": "jq -r '.tool_input.command // empty' | grep -qE '(^|[&;|])[[:space:]]*cd[[:space:]].*[&;][[:space:]]*git([[:space:]]|$)' && printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Use `git -C <path> <subcmd>` instead of `cd <path> && git ...` (rules/git-commands.md). Repeat git -C for each git when chaining.\"}}' || true"
          }
        ]
      }
    ]
